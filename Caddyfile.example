# Template for exposing this service beyond localhost. Copy to `Caddyfile`
# (gitignored -- same pattern as .env vs .env.example) and fill in real
# values before deploying; don't commit the real file, since basicauth
# entries are credential material even though they're hashed.
#
# What this does:
#   - /webhook/confluence and /healthz are reachable with no auth at all.
#     The webhook doesn't need it -- Confluence's request is verified by
#     CONFLUENCE_WEBHOOK_SECRET (HMAC) inside the app itself, and adding a
#     second, unrelated auth layer in front of it would just break real
#     webhook delivery. /healthz stays open so an external monitor/load
#     balancer health check doesn't need credentials either.
#   - Everything else (/ui/*, /) requires HTTP Basic Auth over HTTPS --
#     protects the config page (reads/writes your GitHub/Anthropic/SendGrid
#     credentials), run history, and the webhook simulator.
#
# Usage:
#   1. Generate a bcrypt hash for each person who needs access:
#        podman run --rm docker.io/library/caddy:2 caddy hash-password --plaintext 'their-password'
#      (or `docker run` if using Docker instead of podman)
#   2. Add one line per person under `basicauth` below: <username> <hash>
#   3. Set DOMAIN in .env (or the environment) to your real domain, e.g.
#      confluence-pr-agent.neurealm.com -- Caddy then requests and renews a
#      Let's Encrypt certificate for it automatically. Needs ports 80 and
#      443 reachable from the internet (80 only for the ACME HTTP-01
#      challenge + HTTP->HTTPS redirect).
#   4. For local testing without a real domain/DNS, set
#      DOMAIN=http://localhost:8080 instead -- the explicit http:// scheme
#      tells Caddy to skip automatic HTTPS entirely for that address.
#   5. Set INTERNAL_SHARED_SECRET in .env to a real random value (e.g.
#      `openssl rand -hex 32`) -- the same value must be set for both the
#      caddy and confluence-pr-agent services (podman-compose.yml passes it
#      to both). This app is multi-tenant: each Basic Auth login below gets
#      its own config/credentials/run history, matched up via the
#      X-Auth-User header this file forwards after a successful login (see
#      the protected handle block below). Trusting that header is only
#      safe because nothing can reach the app except through this proxy
#      (see podman-compose.yml -- no host port is published for the app
#      service) -- X-Internal-Secret is the second, cheap layer of defense:
#      the app refuses to trust X-Auth-User from anything that doesn't also
#      present this secret, so a future third container someone adds to
#      the same compose network still can't forge a login by hitting the
#      app directly.

{$DOMAIN} {
	handle /webhook/* {
		reverse_proxy confluence-pr-agent:8000
	}

	handle /healthz {
		reverse_proxy confluence-pr-agent:8000
	}

	# HTTP Basic Auth has no real server-side logout -- the browser just
	# caches the credentials for its own session. This is the standard
	# workaround: always answer 401 with a fresh challenge, so a stale
	# cached credential gets rejected and the browser either re-prompts or
	# (if the person cancels) shows this page instead of the app. Not a
	# true sign-out -- closing the browser (or clearing saved passwords) is
	# the only way to fully forget the credentials -- but it's the best
	# available approximation for Basic Auth. Linked from the app's own nav
	# (base.html) as "Sign out".
	handle /logout {
		header WWW-Authenticate "Basic realm=\"restricted\""
		respond "Signed out. If your browser still prompts you back in automatically, close this tab (or all browser windows) to fully clear the cached credentials." 401
	}

	handle {
		basic_auth {
			# <username> <bcrypt-hash-from-step-1>
			demo-user $2a$14$REPLACE_WITH_A_REAL_HASH_FROM_CADDY_HASH_PASSWORD
		}
		reverse_proxy confluence-pr-agent:8000 {
			# No explicit `header_up -X-Auth-User` strip first -- confirmed
			# (the hard way) that pairing a delete with a set for the same
			# header name in one reverse_proxy block makes Caddy drop the
			# header entirely instead of setting it, silently breaking
			# identity forwarding for every user. Turned out to be
			# unnecessary anyway: header_up's set already fully replaces
			# any client-sent value for this header (verified directly --
			# a request forging X-Auth-User itself still arrives at the
			# app carrying only the real, Caddy-set value). {http.auth.
			# user.id} is set by basic_auth above on a successful login.
			header_up X-Auth-User {http.auth.user.id}
			header_up X-Internal-Secret {$INTERNAL_SHARED_SECRET}
		}
	}
}
